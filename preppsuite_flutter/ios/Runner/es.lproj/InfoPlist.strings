/* Por qué la app necesita la cámara */
"NSCameraUsageDescription" = "PreppSuite usa la cámara para escanear códigos de barras y códigos QR, y para fotografiar artículos de tus provisiones o un texto para el traductor.";

/* Por qué la app necesita Face ID */
"NSFaceIDUsageDescription" = "Si lo activas, PreppSuite desbloquea el bloqueo de la app con Face ID en lugar de con la frase de contraseña.";

/* Por qué la app necesita la red local */
"NSLocalNetworkUsageDescription" = "PreppSuite sincroniza el hogar directamente con un segundo dispositivo de la misma red. Los datos no salen de la red local.";

/* Por qué la app necesita la ubicación */
"NSLocationWhenInUseUsageDescription" = "PreppSuite usa tu ubicación para determinar tu estado federado y darte avisos más precisos, y para encontrar refugios cercanos.";

/* Por qué la app accede a las fotos */
"NSPhotoLibraryUsageDescription" = "PreppSuite accede a tus fotos para que puedas asignar una imagen a un artículo de tus provisiones o traducir el texto de una foto.";
