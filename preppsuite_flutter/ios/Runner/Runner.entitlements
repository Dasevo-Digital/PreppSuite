<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Severe and extreme warnings come through a Focus (#101). The Dart
	     side marks them time-sensitive; without this the system treats them
	     as ordinary. Needs the paid team: with the personal one no profile
	     could be made and no device build signed. iOS only - the Mac
	     packages are signed ad hoc, and a restricted entitlement without a
	     profile would keep the app from starting. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Shared with the home screen widget extension (#105): the app writes
	     the two lamps here, the widget reads them. Nothing else uses it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.dasevo.preppsuite</string>
	</array>
</dict>
</plist>
