platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    drop_destructive_zstd_phase(target)
  end
end

# zstandard_macos ships two build phases: one syncs the zstd C sources into the
# plugin's own directory inside the pub cache, the other deletes them again with
# `rm -rf`. The deleting one declares no outputs and `:execution_position => :any`,
# so Xcode is free to schedule it whenever -- including ahead of the compiler that
# needs those files. Then the build dies on "Build input file cannot be found:
# .../zstd/compress/hist.c", and the next attempt may well succeed, because the
# sync phase has meanwhile put the sources back.
#
# A release build that depends on which of two phases wins a race is not a release
# build, so the deleting phase is dropped here. Nothing about the product changes:
# its only effect is removing sources after they were compiled. What is lost is the
# plugin tidying up the shared pub cache behind itself -- roughly 3 MB of C sources
# that `flutter pub cache clean` takes away anyway, and that the sync phase would
# recreate on the next build regardless.
def drop_destructive_zstd_phase(target)
  # Collected before deleting, and taken out of the object list as well as the
  # project: `delete_if` on Xcodeproj's ObjectList leaves the phase in the
  # written project.pbxproj, which looks like it worked and does not.
  # Matched by substring: CocoaPods renames a podspec script phase to
  # '[CP-User] Remove synced zstd', so comparing against the name from the
  # podspec finds nothing and fails silently.
  doomed = target.build_phases.select do |phase|
    phase.respond_to?(:name) && phase.name.to_s.include?('Remove synced zstd')
  end
  doomed.each do |phase|
    target.build_phases.delete(phase)
    phase.remove_from_project
  end
end
