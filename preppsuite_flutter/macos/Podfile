platform :osx, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# The zstd C sources have to be in place *before* CocoaPods collects the file
# list, or the plugin is built without a single ZSTD_* symbol -- and then every
# Kiwix archive fails to open, because a ZIM keeps even its title in a
# compressed cluster. The app says "a ZIM archive is expected" and means "I
# cannot decompress anything".
#
# zstandard_macos means to handle this itself with `prepare_command`, but
# CocoaPods runs that only for pods it downloads, never for a local one
# (`:path => '.'`), which is what a Flutter plugin always is. So the sources
# are there only if some earlier build left them there -- and the plugin's own
# clean-up phase exists to remove them. 1.7.0 and 1.7.1 shipped that way on
# macOS: a framework of 228 KB holding the Swift registrar and nothing else.
#
# Syncing here makes it independent of what any previous build did.
pre_install do |installer|
  sync_zstd_sources
end

def sync_zstd_sources
  script = File.join(
    File.dirname(File.realpath(__FILE__)),
    'Flutter', 'ephemeral', '.symlinks', 'plugins', 'zstandard_macos',
    'scripts', 'sync_zstd.sh',
  )
  unless File.exist?(script)
    raise "zstandard_macos sync script not found at #{script} -- " \
          'run "flutter pub get" first'
  end

  system('bash', script) || raise('sync_zstd.sh failed; zstd would be missing')

  header = File.join(
    File.dirname(script), '..', 'macos', 'Classes', 'zstd', 'zstd.h',
  )
  unless File.exist?(header)
    raise "sync_zstd.sh ran but #{header} is missing -- the plugin would " \
          'build without zstd'
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.0'
    end
    drop_destructive_zstd_phase(target)
  end
end

# zstandard_macos ships two build phases: one syncs the zstd C sources into the
# plugin's own directory inside the pub cache, the other deletes them again with
# `rm -rf`. The deleting one declares no outputs and `:execution_position => :any`,
# so Xcode is free to schedule it whenever -- including ahead of the compiler that
# needs those files. Then the build dies on "Build input file cannot be found:
# .../zstd/compress/hist.c", and the next attempt may well succeed, because the
# sync phase has meanwhile put the sources back.
#
# A release build that depends on which of two phases wins a race is not a release
# build, so the deleting phase is dropped here. Nothing about the product changes:
# its only effect is removing sources after they were compiled. What is lost is the
# plugin tidying up the shared pub cache behind itself -- roughly 3 MB of C sources
# that `flutter pub cache clean` takes away anyway, and that the sync phase would
# recreate on the next build regardless.
def drop_destructive_zstd_phase(target)
  # Collected before deleting, and taken out of the object list as well as the
  # project: `delete_if` on Xcodeproj's ObjectList leaves the phase in the
  # written project.pbxproj, which looks like it worked and does not.
  # Matched by substring: CocoaPods renames a podspec script phase to
  # '[CP-User] Remove synced zstd', so comparing against the name from the
  # podspec finds nothing and fails silently.
  doomed = target.build_phases.select do |phase|
    phase.respond_to?(:name) && phase.name.to_s.include?('Remove synced zstd')
  end
  doomed.each do |phase|
    target.build_phases.delete(phase)
    phase.remove_from_project
  end
end
