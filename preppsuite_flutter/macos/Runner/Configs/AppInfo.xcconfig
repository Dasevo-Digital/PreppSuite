// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter
// window, and it is what the app menu says under "About" and "Quit" — which
// is why it is the product name and not the Dart package name. It also names
// the built bundle, so `flutter build macos` now produces PreppSuite.app and
// packaging no longer renames it.
PRODUCT_NAME = PreppSuite

// The application's bundle identifier.
//
// Until 2.x it was de.status403.preppsuite. The sandbox container is named
// after it, so the first start under this one carries the household over
// (lib/core/former_identity.dart, and the preferences in
// MainFlutterWindow.swift); both entitlements files allow exactly the two
// former containers for that.
//
// Debug and Profile builds get the test identifier: a `flutter run` under
// the release one would open — and carry over — the real household.
PRODUCT_BUNDLE_IDENTIFIER = de.dasevo.preppsuite
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = de.dasevo.preppsuite.test
PRODUCT_BUNDLE_IDENTIFIER[config=Profile] = de.dasevo.preppsuite.test

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 PreppSuite Contributors. MIT-Lizenz, siehe LICENSE.
