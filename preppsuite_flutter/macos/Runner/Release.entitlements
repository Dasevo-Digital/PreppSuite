<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The sandbox is on. It used to be off, because the app has to keep
	     reading a folder the user picked once — a Nextcloud or Syncthing
	     directory — on every later launch, and under the sandbox that
	     permission dies with the process. The way to keep it is a
	     security-scoped bookmark, which needs native Swift; that code now
	     exists in macos/Runner/StorageBridge.swift, the same shape the iOS
	     build has had all along. See docs/gemeinsamer-ordner.md.

	     Turning it on is what stops macOS asking for folder access again
	     after every update: a sandboxed app is never asked about Documents
	     or Downloads at all, and the bookmark lives in the container,
	     which survives the app being replaced. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- What the user picks in a panel, and the bookmarks made from it. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Apple documents this as the requirement for creating app-scoped
	     security-scoped bookmarks — the ones that survive a restart, which
	     is the entire point of picking a folder here. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- The default place downloads go is ~/Downloads/PreppSuite. Without
	     this the sandbox would deny it and every download would have to
	     start with a folder panel. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<key>com.apple.security.network.client</key>
	<true/>

	<!-- The article view serves the open ZIM archive over a loopback HTTP
	     server (zim_http_server.dart). Binding a listening socket needs
	     this; unsandboxed it worked without, which is why it was missing
	     here and only in DebugProfile. -->
	<key>com.apple.security.network.server</key>
	<true/>

	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<!-- Only for carrying the household over from the former identifier
	     (de.status403.preppsuite, until 2.x): the first start under the
	     new one moves the folder and reads the preferences from the old
	     container. Remove once every installation has been started under
	     the new identifier — and before any store build, which would be
	     rejected for it. See lib/core/former_identity.dart. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Containers/de.status403.preppsuite/</string>
		<string>/Library/Containers/de.status403.preppsuite.test/</string>
	</array>
</dict>
</plist>
