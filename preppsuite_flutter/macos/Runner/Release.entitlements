<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The sandbox is on. It used to be off, because the app has to keep
	     reading a folder the user picked once — a Nextcloud or Syncthing
	     directory — on every later launch, and under the sandbox that
	     permission dies with the process. The way to keep it is a
	     security-scoped bookmark, which needs native Swift; that code now
	     exists in macos/Runner/StorageBridge.swift, the same shape the iOS
	     build has had all along. See docs/gemeinsamer-ordner.md.

	     Turning it on is what stops macOS asking for folder access again
	     after every update: a sandboxed app is never asked about Documents
	     or Downloads at all, and the bookmark lives in the container,
	     which survives the app being replaced. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- flutter_secure_storage stores the local database key in Keychain.
	     On a sandboxed macOS app Keychain Sharing has to be declared even
	     when no group is shared with another app.  Without this empty list
	     SecItemAdd fails with errSecMissingEntitlement (-34018) before Flutter
	     can draw its first frame. -->
	<key>keychain-access-groups</key>
	<array/>

	<!-- What the user picks in a panel, and the bookmarks made from it. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Apple documents this as the requirement for creating app-scoped
	     security-scoped bookmarks — the ones that survive a restart, which
	     is the entire point of picking a folder here. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>

	<!-- The default place downloads go is ~/Downloads/PreppSuite. Without
	     this the sandbox would deny it and every download would have to
	     start with a folder panel. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<key>com.apple.security.network.client</key>
	<true/>

	<!-- The article view serves the open ZIM archive over a loopback HTTP
	     server (zim_http_server.dart). Binding a listening socket needs
	     this; unsandboxed it worked without, which is why it was missing
	     here and only in DebugProfile. -->
	<key>com.apple.security.network.server</key>
	<true/>

	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>

	<!-- Only so the app can read what an unsandboxed version of itself left
	     behind: the household database and the settings from 0.13.1 and
	     earlier. See macos/Runner/SandboxMigration.swift. macOS migrates
	     these two places by itself, but only when it creates the container,
	     and a container may already exist from an earlier sandboxed launch
	     — then it silently does nothing and the household is lost.

	     These go away once no installation predating 0.14.0 is left. They
	     grant nothing beyond this app's own two files. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/Library/Application Support/de.status403.preppsuite/</string>
		<string>/Library/Preferences/de.status403.preppsuite.plist</string>
		<string>/Library/Application Support/de.status403.preppsuite.test/</string>
		<string>/Library/Preferences/de.status403.preppsuite.test.plist</string>
	</array>
</dict>
</plist>
