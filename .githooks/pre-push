#!/usr/bin/env bash
# Runs the quick CI checks before a push to main or a tag, so a broken state
# never reaches Gitea and from there the GitHub mirror (each failed run there
# sends a mail). Native platform builds stay with the CI.
#
# Set up once per clone:  git config core.hooksPath .githooks
# Skip once:              git push --no-verify
set -euo pipefail

zero=0000000000000000000000000000000000000000
commit=""
while read -r _ local_sha remote_ref _; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref
  case "$remote_ref" in
    refs/heads/main | refs/tags/*) commit=$(git rev-parse "$local_sha^{commit}") ;;
  esac
done
[ -z "$commit" ] && exit 0

root=$(git rev-parse --show-toplevel)
# Each run logs to a file of its own: hooks of other repositories may run at
# the same time and would otherwise write into the same log.
log=$(mktemp "${TMPDIR:-/tmp}/preppsuite-pre-push.XXXXXX")
worktree=""
cleanup() {
  rm -f "$log"
  if [ -n "$worktree" ]; then
    git -C "$root" worktree remove --force "$worktree" >/dev/null 2>&1 ||
      rm -rf "$worktree"
  fi
}
trap cleanup EXIT
# Test exactly what is pushed: the checkout itself when it matches, otherwise
# a throwaway worktree of the pushed commit.
if [ "$(git rev-parse HEAD)" = "$commit" ] &&
  [ -z "$(git status --porcelain --untracked-files=no)" ]; then
  dir=$root
else
  worktree=$(mktemp -d)
  dir=$worktree
  git worktree add --detach --quiet "$dir" "$commit"
fi
cd "$dir"

# Git invokes hooks with the current checkout in the environment. Keeping
# these values after changing into a linked or temporary worktree makes
# Flutter mistake that checkout for its own repository and can alter the
# shared SDK's tool stamp. Git commands below rediscover this worktree from
# the current directory instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

step() {
  echo "pre-push: $*" >&2
  if ! "$@" >"$log" 2>&1; then
    tail -n 60 "$log" >&2
    echo "pre-push: failed: $* (push cancelled; skip with --no-verify)" >&2
    exit 1
  fi
}

step tool/repo_privacy_check.sh
step flutter pub get
step flutter analyze
step dart format --output=none --set-exit-if-changed .
step bash -c "cd preppsuite_flutter && TZ=Europe/Berlin flutter test test/features/inventory/inventory_calendar_export_test.dart test/core/calendar_days_test.dart"
step bash -c "cd preppsuite_flutter && flutter test"
echo "pre-push: all checks passed" >&2
