# Files and directories created by pub
.dart_tool/
.packages

# Pubspec overrides
pubspec_overrides.yaml

# Build output
build/

# Erzeugt von scripts/generate-env.sh — enthaelt Geheimnisse
.env

# Firebase-Konfiguration. Die App benutzt kein Firebase; diese Dateien lagen
# aus einem aufgegebenen Versuch im Repository und trugen einen API-Schluessel
# mit sich. Sie stehen hier, damit ein "flutterfire configure" sie nicht
# unbemerkt wieder hereinlegt.
google-services.json
GoogleService-Info.plist

# Gebaute Pakete. Sie gehoeren auf den Desktop, nicht in die Historie: ein
# einziges "git add -A" wuerde hier 65 MB Binaerdateien dauerhaft einchecken.
releases/

# Die Mess-App unter tool/ocr_probe/android ist ein eigenes Gradle-Projekt.
tool/ocr_probe/android/build/
tool/ocr_probe/android/app/build/
tool/ocr_probe/android/.gradle/
tool/ocr_probe/android/local.properties
# Der Wrapper wird nicht mitgeliefert -- wie beim Flutter-Projekt daneben,
# das ihn sich beim Bauen selbst holt. `run.sh` kopiert ihn von dort.
tool/ocr_probe/android/gradlew
tool/ocr_probe/android/gradle/wrapper/gradle-wrapper.jar

# Lokale Arbeitsanweisungen, nicht veröffentlichen
/AGENTS.md

# Finder metadata
.DS_Store
